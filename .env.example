# 실제 값은 .env에만 적는다 (커밋 금지, .gitignore가 이미 제외).
# 이 파일은 플레이스홀더만 담아 추적한다 — 새 환경 변수를 추가하면 여기도 같이 갱신한다.

# 예시 (프로젝트에 맞게 교체):
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# API_KEY=your-api-key-here

# --- 체인 ---
# localhost | baseSepolia
CHAIN=localhost
RPC_URL=http://127.0.0.1:8545

# --- 저장소 ---
DATABASE_PATH=data.local/app.sqlite

# --- Kiln (서버·CLI 전용, NEXT_PUBLIC_ 금지) ---
# fake | real
KILN_MODE=fake
KILN_API_KEY=sk-bk-your-kiln-key-here
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=qwen3-32b
# default | kwargs_off | no_think
KILN_THINKING_MODE=default
KILN_MAX_TOKENS_PARSE=2048
KILN_MAX_TOKENS_JUDGE=1024

# --- 지갑 (CLI 전용 — Next 서버는 로드하지 않음. 테스트 전용 계정만) ---
AGENT_PRIVATE_KEY=0xyour-agent-test-wallet-private-key
OWNER_PRIVATE_KEY=0xyour-owner-test-wallet-private-key
OWNER_ADDRESS=0xYourOwnerWalletAddress
FEE_RECIPIENT_ADDRESS=0xYourFeeRecipientAddress
